logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor / OS
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# Vite cache
.vite/

# Optional: test coverage
coverage/
